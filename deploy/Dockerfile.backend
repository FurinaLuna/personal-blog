# 后端镜像
#
# 多阶段构建的意义有限（Python 不像 Node 有"构建产物"），
# 但显式区分 builder / runtime 仍然值得：万一将来某个依赖需要现场编译，
# 编译工具链只留在 builder 里，运行时镜像不带它，体积更小、攻击面更小。
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 这里**刻意不装 build-essential**。
# 原先装着，是因为"编译型依赖总得有编译器"——但 requirements.lock 里 51 个包
# 全都提供 cp312 的 manylinux wheel，实测整条 pip install 输出里
# 一条 "Building wheel for ..." 都没有，编译器一次都没被调用。
# 而 build-essential 要从 deb.debian.org 拉 ~200MB（首次构建实测多花 3 分半，
# 国内网络更久），属于纯粹的等待成本。
#
# 将来真出现需要现场编译的依赖，pip 会以
# "error: command 'gcc' failed: No such file or directory" 明确失败，
# 那时把这行加回来即可 —— 失败是响亮的，不会悄悄产出坏镜像。
#
# RUN apt-get update \
#  && apt-get install -y --no-install-recommends build-essential \
#  && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 依赖清单和 src 分开 COPY，且**依赖装在 src 之前**。
# 这里对应前端 Dockerfile 里"先只拷 package.json"那一步：
# 装依赖是整条构建里最慢的一段，而它只取决于清单文件。
# 两者写在同一个 RUN 里的话，改任何一行业务代码都会让依赖重装一遍。
COPY pyproject.toml README.md requirements.lock ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip \
 && /opt/venv/bin/pip install -r requirements.lock

COPY src ./src

# --no-deps 装项目本身：避免 pip 又解析一遍依赖范围，与锁文件产生分歧
# （依赖已经由上面那步按锁文件装好了，这里只装这个包自己）。
RUN /opt/venv/bin/pip install --no-deps .


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    TZ=Asia/Shanghai

# 用非 root 用户跑应用：容器被攻破时能造成的破坏面小一个量级。
# curl 用于 HEALTHCHECK。
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 app \
 && useradd --uid 1000 --gid app --create-home app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=app:app pyproject.toml README.md ./
COPY --chown=app:app src ./src
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini ./

# 入口脚本：先跑迁移再启动应用（为什么这么做见脚本内的注释）
COPY --chown=app:app scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# 兜底去掉 CRLF：Windows 上检出时 *.sh 可能是 CRLF，而带 \r 的脚本在容器里
# 会以「no such file or directory」告终 —— 和「文件真的不存在」长得一模一样，
# 是个能把人带偏半小时的报错。.gitattributes 已为 *.sh 钉了 eol=lf，这里再防一手。
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
 && chmod +x /usr/local/bin/docker-entrypoint.sh

# storage 会在 compose 里挂成卷，这里先建好并交出属主
RUN mkdir -p /app/storage/uploads /app/storage/avatars && chown -R app:app /app/storage

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

# 生产不开 --reload。三个参数都是**刻意**这么定的，改动前请先读这段。
#
# ``--workers 1``：不是"图省事"，而是当前架构下唯一正确的取值。
#   - 限流器是**进程内**的（``utils/ratelimit.py``），多 worker 时每个进程
#     各记一份计数，实际放行量会乘以 worker 数——登录限流 5/分 会变成 10/分；
#   - ``lifespan`` 里有启动期副作用（建表、灌初始数据、清理访问日志、重建全文索引），
#     多 worker 会并发执行。实测把两个进程同时冷启动到同一个 SQLite 文件上，
#     其中一个会以 ``sqlite3.OperationalError: disk I/O error`` 启动失败 ——
#     并发 DDL 是 SQLite 的固有限制，不是 seed 的锅（seed 已改成原子 upsert，
#     约束冲突不会再让它挂，但建表这一步没有等价保护）。
#   个人博客的流量用不上多进程；真要扩，先换 PostgreSQL 并把限流换成共享存储。
#
# ``--no-proxy-headers``：把「是否信任代理头」的判定**只留在应用层**一处
#   （``TRUST_PROXY_HEADERS`` + ``api/deps.py:client_ip``）。
#   此前这里是 ``--proxy-headers --forwarded-allow-ips *``，会让 uvicorn 抢在
#   应用之前按 ``X-Forwarded-For`` 改写 ``scope["client"]`` —— 应用层的开关
#   就被架空了：即使 ``TRUST_PROXY_HEADERS=false``，``request.client.host``
#   也已经是客户端可控的值。实测：伪造 5 个不同的 XFF，访客 UV 从 1 涨到 5；
#   换回 ``--no-proxy-headers`` 后同样的伪造只算 1 个访客。
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers"]
