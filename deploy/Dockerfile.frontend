# 前端镜像：构建产物交给 Nginx 托管
#
# 前端是纯静态产物，所以最终镜像里只留 nginx + dist，不带 node_modules。
# 镜像体积从 ~400MB 降到 ~50MB。
FROM node:22-alpine AS builder

WORKDIR /app

# 先只拷贝依赖清单：只要依赖没变，这一层就能命中缓存，
# 改业务代码时不会每次都重新 npm ci（这是构建提速最关键的一步）
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .

# 同域部署时 API 走相对路径，由 Nginx 反向代理到后端
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build


FROM nginx:1.27-alpine AS runtime

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx 配置取自 deploy/，但本镜像的构建上下文是 frontend/ ——
# 上下文之外的文件 COPY 不到：原先是 `COPY deploy/nginx.conf`，会以
# "failed to compute cache key: /deploy/nginx.conf not found" 直接构建失败。
# （这是本文件真实存在的问题：Docker 一直没被跑过，所以一直没人发现。）
#
# 解法是让 compose 额外挂一个名为 deploy 的构建上下文进来，而不是把配置
# 复制一份到 frontend/ —— 两份配置迟早漂移，而「改了没生效」在 nginx 上
# 排查代价很高（nginx 自己的日志里什么都不会说）。
# 因此：**本镜像要经 `docker compose build` 构建**，直接
# `docker build frontend/` 会因为缺少这个上下文而报错。
COPY --from=deploy nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
