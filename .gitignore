# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
# import-linter（Grimp）的缓存目录。它会在目录内自写一个含 `*` 的 .gitignore 自忽略，
# 但这里显式兜一层：万一换了版本不再自忽略，也不会被误提交。
# 不加 backend/ 前缀，根目录和 backend/ 下的实例都能覆盖。
.import_linter_cache/
.coverage
htmlcov/
.mypy_cache/
# 本项目用 python -m venv + pip install -e ".[dev]"（见 Makefile / README 快速开始），
# 不走 uv。这个 lock 是某次误跑 uv 留下的产物，与 pip 工作流不一致，提交反而误导。
# 只在版本库里忽略，文件本身保留，将来真要迁 uv 还能接着用。
backend/uv.lock

# ---------------- 环境与密钥 ----------------
# .env.example 要提交，.env 绝对不能提交（里面有 JWT 密钥和数据库密码）
.env
.env.local
.env.*.local
!.env.example

# ---------------- 数据库 ----------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------- 用户上传的媒体文件 ----------------
# 目录结构要保留（靠 .gitkeep），但内容不进版本库
backend/storage/uploads/*
backend/storage/avatars/*
!backend/storage/uploads/.gitkeep
!backend/storage/avatars/.gitkeep

# ---------------- Node / 前端 ----------------
node_modules/
dist/
dist-ssr/
.vite/
.npm-cache/
*.local
*.tsbuildinfo
coverage/

# ---------------- 编辑器与系统 ----------------
.vscode/*
!.vscode/extensions.json
.idea/
# Trae（另一款 AI IDE）的本地产物目录，属于用户 IDE 数据，不进版本库
.trae/
.DS_Store
Thumbs.db
*.swp
# WorkBuddy 会话记忆与运行产物（不入库）
.workbuddy/

# ---------------- 日志与临时文件 ----------------
*.log
npm-debug.log*
yarn-error.log*
alembic_boot.db

# ---------------- 端到端验证产物 ----------------
# CDP 脚本的截图/报告统一写入 shots/（make smoke 等目标会传 ./shots/<名称>），
# 每次运行都会重写，不入库
shots/
# 数据库一致性备份（VACUUM INTO 产物，本地用）
blog.db.bak-*
backend/blog.db.bak-*
# scripts/backup_db.py 的输出目录：里面是完整数据库快照，绝不能入库
backend/backups/
playwright-report/
test-results/
# 样式基线的采集体（本地比对用，比对完即弃）
style-baseline*.json
