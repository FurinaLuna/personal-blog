# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
# import-linter（Grimp）的缓存目录。它会在目录内自写一个含 `*` 的 .gitignore 自忽略，
# 但这里显式兜一层：万一换了版本不再自忽略，也不会被误提交。
# 不加 backend/ 前缀，根目录和 backend/ 下的实例都能覆盖。
.import_linter_cache/
.coverage
htmlcov/
.mypy_cache/
# 本项目用 python -m venv + pip install -e ".[dev]"（见 Makefile / README 快速开始），
# 不走 uv。这个 lock 是某次误跑 uv 留下的产物，与 pip 工作流不一致，提交反而误导。
# 只在版本库里忽略，文件本身保留，将来真要迁 uv 还能接着用。
backend/uv.lock

# ---------------- 环境与密钥 ----------------
# .env.example 要提交，.env 绝对不能提交（里面有 JWT 密钥和数据库密码）
.env
.env.local
.env.*.local
!.env.example

# ---------------- 数据库 ----------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------- 用户上传的媒体文件 ----------------
# 目录结构要保留（靠 .gitkeep），但内容不进版本库
backend/storage/uploads/*
backend/storage/avatars/*
!backend/storage/uploads/.gitkeep
!backend/storage/avatars/.gitkeep

# ---------------- Node / 前端 ----------------
node_modules/
dist/
dist-ssr/
.vite/
.npm-cache/
*.local
*.tsbuildinfo
coverage/

# ---------------- 编辑器与系统 ----------------
.vscode/*
!.vscode/extensions.json
.idea/
# Trae（另一款 AI IDE）的本地产物目录，属于用户 IDE 数据，不进版本库
.trae/
.DS_Store
Thumbs.db
*.swp
# WorkBuddy 会话记忆与运行产物（不入库）
.workbuddy/

# ---------------- 日志与临时文件 ----------------
*.log
npm-debug.log*
yarn-error.log*
alembic_boot.db

# ---------------- 测试临时区 ----------------
# tests/conftest.py 在「系统的临时目录不可用」时会把测试库 / 上传产物 / pytest 基目录
# 落到这里（见该文件 _safe_temp_dir 的说明：此时 tempfile.gettempdir() 会返回工作目录，
# 于是这些产物生成在仓库里，git status 一直脏着，git add -A 会把测试媒体提交进去）。
.pytest-tmp/
# pytest 的 cacheprovider 在「写不进 .pytest_cache」时会在工作目录旁开一个
# pytest-cache-files-* 临时目录（受限权限 / 只读缓存目录下会出现）
pytest-cache-files-*/
# 上面那种情况在修复前留下的两个目录名，兜一层避免误提交
backend/personal_blog_media/
backend/pytest-of-*/
# pytest 的 `tmp_path` fixture 默认在 basetemp 下建目录；受限权限下它连自己的工作目录
# 都删不掉（`shutil.rmtree` → WinError 5），`--basetemp` 指到哪就永久留在哪。
# 与上面 `backend/pytest-of-*` 同一类，都是「沙箱/只读环境下必然出现」的残留
backend/.pytest-sandbox-tmp/
# `tools/e2e_live/e2e_run.py` 用 `tempfile.mkdtemp(prefix="blog-e2e-")` 建工作目录；
# 在受限沙箱里 `mkdtemp` 建出来的目录会被加上「不可访问」的 ACL（连自己都读不了、
# 更删不掉），把 TEMP 指到仓库内就会留下这种空壳目录。同样是环境产物，不入库
.e2e-tmp/

# ---------------- 端到端验证产物 ----------------
# CDP 脚本的截图/报告统一写入 shots/（make smoke 等目标会传 ./shots/<名称>），
# 每次运行都会重写，不入库
shots/
# Hexo 迁移工具的上传缓存（内容哈希 -> 站内 URL）。重跑时靠它跳过已上传的图片，
# 是本机产物：URL 里含服务端的月份子目录、且随时可重建，不入库
tools/hexo_import/.import-cache.json
# 数据库一致性备份（VACUUM INTO 产物，本地用）
blog.db.bak-*
backend/blog.db.bak-*
# scripts/backup_db.py 的输出目录：里面是完整数据库快照，绝不能入库
backend/backups/
# compose 里 backup 服务的输出目录（绑定挂载到宿主，见 docker-compose.yml）。
# 与 backend/backups/ 同理：完整库快照，且会随每次备份 churn。
backups/
# 自管 TLS：证书与私钥（deploy/certs 就是 certbot 的 /etc/letsencrypt）
deploy/certs/
# ACME HTTP-01 的 webroot：挑战文件是运行期临时产物
certbot-webroot/
playwright-report/
test-results/
# 样式基线的采集体（本地比对用，比对完即弃）
style-baseline*.json
# tools/e2e_live/ 每次运行的输出：按时间戳生成，且内含本机临时目录的绝对路径
# （工作目录 / 测试库的真实路径），既会 churn 也不该把本机路径带进仓库。
# 保留的是 e2e_run.py / probe.py 与人工整理的两份最终报告。
tools/e2e_live/reports/e2e-report-*.md
tools/e2e_live/reports/e2e-results-*.json
# e2e_run.py 自建的临时工作目录（内含 e2e.db* 与 storage/ 上传物）。
# 它在 Windows 上偶尔删不干净（uvicorn 子进程的文件句柄尚未释放），
# 于是残留在仓库根目录 —— 内容包含测试数据库与上传文件，绝不能入库。
blog-e2e-*/
# 本地起真实服务做端到端验证时用的临时工作区（临时库 + storage/ 上传物 + 日志）。
# 同样是"跑一次就有一堆二进制产物"，绝不入库。
.local-e2e/
# 迁移 / 查询计划探测用的临时目录（本仓库的沙箱不允许在系统临时目录下新建目录，
# 所以这类探测只能落在仓库内，用完即删 —— 这里兜一层防误提交）
.migr-probe/
.drift-check/
.idx-probe/
