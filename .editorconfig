# 让编辑器行为与仓库约定一致，避免出现「只有某个人的编辑器」才有的格式差异
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Markdown 里行尾两个空格是「硬换行」语法，裁剪掉会改变渲染结果
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{png,jpg,jpeg,webp,ico,db}]
insert_final_newline = false
