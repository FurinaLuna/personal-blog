# 统一换行符：仓库内一律 LF，避免 Windows 上出现 CRLF 与 LF 混杂
# （之前出现过 "LF will be replaced by CRLF" 警告，就是因为缺少这份约定）

* text=auto

# 源码与文本一律 LF
*.py        text eol=lf
*.ts        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.vue       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.mako      text eol=lf
*.example   text eol=lf
*.svg       text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
LICENSE     text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf

# Windows 专属脚本保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.webp      binary
*.ico       binary
*.db        binary
