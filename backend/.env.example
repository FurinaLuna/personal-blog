# ============================================================
# 个人博客后端环境变量
# 复制为 .env 后按注释修改。开发环境大部分可以保持默认。
# ============================================================

# ---------- 基础 ----------
# development | testing | production
# 设为 production 后：/docs 与 /redoc 会自动关闭
APP_ENV=development
DEBUG=true
# 服务名：会出现在 OpenAPI 文档标题与启动日志里
APP_NAME=Personal Blog API
# API 路由前缀。前端 VITE_API_BASE_URL 需要与它对齐；
# 改这里等于改所有接口地址，非必要不要动
API_V1_PREFIX=/api/v1

# ---------- 数据库 ----------
# 开发默认 SQLite（零依赖，删掉文件即重置）
# DATABASE_URL=sqlite+aiosqlite:///./blog.db
# 生产推荐 PostgreSQL（需要先 pip install ".[postgres]"）
# DATABASE_URL=postgresql+asyncpg://blog:密码@db:5432/blog

# 启动时自动建表。
# 开发方便；**生产必须设为 false**，改由 `alembic upgrade head` 管理表结构变更
DB_AUTO_CREATE=true
DB_ECHO=false

# ---------- JWT ----------
# ⚠️ 生产必须替换！用下面这条命令生成：
#     openssl rand -hex 32
# 密钥长度不足会显著降低签名强度（HS256 建议 >= 32 字节）
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
# 多个来源用逗号分隔或 JSON 数组均可（两种写法都支持）。
# 生产只填真实前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 文件上传 ----------
STORAGE_DIR=./storage
MEDIA_URL_PREFIX=/media
# 10 MB。注意要与 Nginx 的 client_max_body_size 保持一致
MAX_UPLOAD_SIZE=10485760
THUMBNAIL_MAX_WIDTH=480
THUMBNAIL_MAX_HEIGHT=480
# 上传图片时顺带生成的多尺寸变体宽度档位（逗号分隔）。
# 宽度不足的档位自动跳过（不放大）；编码优先 AVIF，无编码器时降级 WEBP
IMAGE_VARIANT_WIDTHS=480,800,1600
# 允许上传的图片 MIME（服务端按**真实解码结果**判型，不信任客户端声明的
# Content-Type）。⚠️ 默认**刻意不含 image/svg+xml**：SVG 是 XML，可以内嵌
# <script>，从本站同源直出就等于给了攻击者一个存储型 XSS。真要用 SVG，
# 请单独放到独立域名下托管。
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif
# 允许上传的非图片附件 MIME。同样是白名单，不在列表里的一律拒绝。
ALLOWED_FILE_TYPES=application/pdf,application/zip,text/plain,text/markdown,application/octet-stream

# ---------- 站点对外地址 ----------
# RSS / sitemap 里的链接必须是绝对 URL，生产改成正式域名（含协议、不带尾斜杠）
SITE_BASE_URL=http://localhost:5173
# 文章详情页路径模板（用于 RSS / sitemap 里的链接）。
# 必须与前端路由表一致，pytest 里有用例做机器比对
SITE_ARTICLE_PATH=/article/{slug}

# ---------- 可观测性与限流 ----------
# 访问日志是否用 JSON 输出。日志收集器（Loki / ELK）按字段过滤更省事；
# 本地调试想人读可以设 false
LOG_JSON=true
LOG_LEVEL=INFO
# 是否信任 X-Forwarded-For。
# ⚠️ 只有确实部署在可信反代（nginx）之后才设 true。
# 该请求头可被客户端伪造：盲信会让限流可绕过，还能借伪造 IP 把别人封掉，
# 并让伪造 IP 被当作评论者地址写进数据库
TRUST_PROXY_HEADERS=false
# 限流开关（登录 5/分、评论 5/分、点赞 20/分）。
# 压测或本地联调可临时关闭，生产不建议
RATE_LIMIT_ENABLED=true
# 访问日志（visit_logs）的留存天数。仪表盘最多只读近 90 天，
# 默认给到两倍留出回头看的余地；启动时会自动清理更早的记录。
# 设为 0 表示不清理（表会无限增长，不建议）。
VISIT_LOG_RETENTION_DAYS=180

# ---------- 评论邮件通知（SMTP）----------
# 默认全部关闭：不开通知时评论接口完全不受影响，只是不发信。
# 需要「有人回复我的评论时发邮件提醒」时按下面填：
#
# QQ 邮箱：SMTP_HOST=smtp.qq.com      SMTP_PORT=465  SMTP_USE_TLS=true
# 163 邮箱：SMTP_HOST=smtp.163.com    SMTP_PORT=465  SMTP_USE_TLS=true
# 密码栏填**授权码**（在邮箱设置里开启 SMTP 服务后获取），不是登录密码。
#
# 另外要把 SITE_BASE_URL 配成正式域名——邮件里的文章链接和退订链接全靠它拼。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址；留空时回落到 SMTP_USERNAME
SMTP_FROM=
# true = 隐式 TLS（465 端口）。587 端口的 STARTTLS 暂未支持
SMTP_USE_TLS=true

# ---------- 初始化站长账号 ----------
# 仅在数据库里没有该用户时创建。「上线后请立即修改密码」
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# 是否写入演示文章（4 篇示例）。正式站设为 false
SEED_DEMO_DATA=true
