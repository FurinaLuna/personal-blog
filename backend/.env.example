# ============================================================
# 个人博客后端环境变量
# 复制为 .env 后按注释修改。开发环境大部分可以保持默认。
# ============================================================

# ---------- 基础 ----------
# development | testing | production
# 设为 production 后：/docs 与 /redoc 会自动关闭
APP_ENV=development
DEBUG=true
# 服务名：会出现在 OpenAPI 文档标题与启动日志里
APP_NAME=Personal Blog API
# API 路由前缀。前端 VITE_API_BASE_URL 需要与它对齐；
# 改这里等于改所有接口地址，非必要不要动
API_V1_PREFIX=/api/v1

# ---------- 数据库 ----------
# 开发默认 SQLite（零依赖，删掉文件即重置）
# DATABASE_URL=sqlite+aiosqlite:///./blog.db
# 生产推荐 PostgreSQL（需要先 pip install ".[postgres]"）
# DATABASE_URL=postgresql+asyncpg://blog:密码@db:5432/blog

# 启动时自动建表。
# 开发方便；**生产必须设为 false**，改由 `alembic upgrade head` 管理表结构变更
DB_AUTO_CREATE=true
DB_ECHO=false

# ---------- JWT ----------
# ⚠️ 生产必须替换！用下面这条命令生成：
#     openssl rand -hex 32
# 密钥长度不足会显著降低签名强度（HS256 建议 >= 32 字节）
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Refresh Token 的传输方式 ----------
# refresh token **默认走 httpOnly Cookie**：放进 localStorage 时，任何一次 XSS
# （第三方依赖漏洞、v-html 误用、恶意浏览器扩展）都能把它读走，并顺着轮换链
# 续期出新的 access token，形成长期冒充。加了 httpOnly 之后 JS 读不到它。
# 配套的取舍：access token 只存前端内存（刷新页面即丢），
# 所以前端每次冷启动都要先拿 refresh Cookie 换一枚新的 access token。
REFRESH_TOKEN_COOKIE_NAME=blog_refresh
# 「会话提示」Cookie：**非 httpOnly**、值恒为 1、不含任何秘密。
# 前端靠它判断"这台浏览器可能有会话"，从而让公开页面跳过那次多余的
# POST /auth/refresh（access token 只存内存，JS 侧否则无从判断有没有会话）。
# 它的 path 固定是 /（不同于 refresh Cookie 的 /api/v1/auth），否则页面 JS 读不到。
SESSION_HINT_COOKIE_NAME=blog_session
# 是否给 Cookie 加 Secure。留空 = 跟着 APP_ENV 走（生产自动 true）。
# ⚠️ 开发环境是 http://localhost，对它加 Secure 会被浏览器**直接拒绝写入**，
# 症状是「登录 200 但刷新必掉线」。TLS 由反向代理终结、应用只看到 http 时，
# 需要显式设 true
# COOKIE_SECURE=true
# lax（默认）：跨站 XHR 不带它，同站部署（nginx 反代 / Vite 代理）完全够用。
# strict：更严，但从外站链接跳进来时第一次请求不带 Cookie。
# none：⚠️ 必须同时 Secure，且只在前后端不同域时才需要——否则 refresh token
# 会被任意站点在明文链路上带走，比放回 localStorage 还糟
COOKIE_SAMESITE=lax
# Cookie 域名。留空 = 绑定当前完整域名（推荐）；
# 跨子域共享登录态时才填（如 blog.example.com 与 api.example.com 共用）
# COOKIE_DOMAIN=example.com
# 是否在**响应体**里也返回 refresh token。只给 curl / CI 这类拿不到 Cookie Jar
# 的非浏览器客户端开：浏览器一律走 Cookie，否则响应体里那一份页面 JS 照样读得到
REFRESH_TOKEN_IN_BODY=false

# ---------- CORS ----------
# 多个来源用逗号分隔或 JSON 数组均可（两种写法都支持）。
# 生产只填真实前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 文件上传 ----------
STORAGE_DIR=./storage
MEDIA_URL_PREFIX=/media
# 10 MB。注意要与 Nginx 的 client_max_body_size 保持一致
MAX_UPLOAD_SIZE=10485760
THUMBNAIL_MAX_WIDTH=480
THUMBNAIL_MAX_HEIGHT=480
# 上传图片时顺带生成的多尺寸变体宽度档位（逗号分隔）。
# 宽度不足的档位自动跳过（不放大）；编码优先 AVIF，无编码器时降级 WEBP
IMAGE_VARIANT_WIDTHS=480,800,1600
# 允许上传的图片 MIME（服务端按**真实解码结果**判型，不信任客户端声明的
# Content-Type）。⚠️ 默认**刻意不含 image/svg+xml**：SVG 是 XML，可以内嵌
# <script>，从本站同源直出就等于给了攻击者一个存储型 XSS。真要用 SVG，
# 请单独放到独立域名下托管（加到这个列表里也没用：Pillow 不解 SVG，
# 它会掉到下面的扩展名白名单去判定，而 .svg 不在其中）。
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,image/bmp
# 允许上传的非图片附件，单位是**扩展名（含前导点）**而不是 MIME：
# 非图片附件不看内容（没有可靠的嗅探手段），判定就是「扩展名在不在白名单里」，
# 所以配置的单位必须和判定单位一致。同样是白名单，不在列表里的一律拒绝；
# 可执行 / 可被浏览器当同源脚本执行的后缀（html/js/exe/svg 等）不要放进来。
ALLOWED_FILE_TYPES=.pdf,.zip,.txt,.md,.csv,.json,.docx,.xlsx,.pptx,.epub

# ---------- 站点对外地址 ----------
# RSS / sitemap 里的链接必须是绝对 URL，生产改成正式域名（含协议、不带尾斜杠）
SITE_BASE_URL=http://localhost:5173
# 文章详情页路径模板（用于 RSS / sitemap 里的链接）。
# 必须与前端路由表一致，pytest 里有用例做机器比对
SITE_ARTICLE_PATH=/article/{slug}

# ---------- 可观测性与限流 ----------
# 访问日志是否用 JSON 输出。日志收集器（Loki / ELK）按字段过滤更省事；
# 本地调试想人读可以设 false
LOG_JSON=true
LOG_LEVEL=INFO
# 是否信任 X-Forwarded-For。
# ⚠️ 只有确实部署在可信反代（nginx）之后才设 true。
# 该请求头可被客户端伪造：盲信会让限流可绕过，还能借伪造 IP 把别人封掉，
# 并让伪造 IP 被当作评论者地址写进数据库
TRUST_PROXY_HEADERS=false
# 限流开关（登录 5/分、评论 5/分、点赞 20/分）。
# 压测或本地联调可临时关闭，生产不建议
RATE_LIMIT_ENABLED=true
# 访问日志（visit_logs）的留存天数。仪表盘最多只读近 90 天，
# 默认给到两倍留出回头看的余地；启动时会自动清理更早的记录。
# 设为 0 表示不清理（表会无限增长，不建议）。
VISIT_LOG_RETENTION_DAYS=180

# ---------- 评论邮件通知（SMTP）----------
# 默认全部关闭：不开通知时评论接口完全不受影响，只是不发信。
# 需要「有人回复我的评论时发邮件提醒」时按下面填：
#
# QQ 邮箱：SMTP_HOST=smtp.qq.com      SMTP_PORT=465  SMTP_USE_TLS=true
# 163 邮箱：SMTP_HOST=smtp.163.com    SMTP_PORT=465  SMTP_USE_TLS=true
# 密码栏填**授权码**（在邮箱设置里开启 SMTP 服务后获取），不是登录密码。
#
# 另外要把 SITE_BASE_URL 配成正式域名——邮件里的文章链接和退订链接全靠它拼。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址；留空时回落到 SMTP_USERNAME
SMTP_FROM=
# true = 隐式 TLS（465 端口）。587 端口的 STARTTLS 暂未支持
SMTP_USE_TLS=true

# ---------- 初始化站长账号 ----------
# 仅在数据库里没有该用户时创建。「上线后请立即修改密码」
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# 是否写入演示文章（4 篇示例）。正式站设为 false
SEED_DEMO_DATA=true
