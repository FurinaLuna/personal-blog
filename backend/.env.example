# ============================================================
# 个人博客后端环境变量
# 复制为 .env 后按注释修改。开发环境大部分可以保持默认。
# ============================================================

# ---------- 基础 ----------
# development | testing | production
# 设为 production 后：/docs 与 /redoc 会自动关闭
APP_ENV=development
DEBUG=true

# ---------- 数据库 ----------
# 开发默认 SQLite（零依赖，删掉文件即重置）
# DATABASE_URL=sqlite+aiosqlite:///./blog.db
# 生产推荐 PostgreSQL（需要先 pip install ".[postgres]"）
# DATABASE_URL=postgresql+asyncpg://blog:密码@db:5432/blog

# 启动时自动建表。
# 开发方便；**生产必须设为 false**，改由 `alembic upgrade head` 管理表结构变更
DB_AUTO_CREATE=true
DB_ECHO=false

# ---------- JWT ----------
# ⚠️ 生产必须替换！用下面这条命令生成：
#     openssl rand -hex 32
# 密钥长度不足会显著降低签名强度（HS256 建议 >= 32 字节）
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
# 多个来源用逗号分隔。生产只填真实前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 文件上传 ----------
STORAGE_DIR=./storage
MEDIA_URL_PREFIX=/media
# 10 MB。注意要与 Nginx 的 client_max_body_size 保持一致
MAX_UPLOAD_SIZE=10485760
THUMBNAIL_MAX_WIDTH=480
THUMBNAIL_MAX_HEIGHT=480

# ---------- 站点对外地址 ----------
# RSS / sitemap 里的链接必须是绝对 URL，生产改成正式域名（含协议、不带尾斜杠）
SITE_BASE_URL=http://localhost:5173

# ---------- 可观测性与限流 ----------
# 访问日志是否用 JSON 输出。日志收集器（Loki / ELK）按字段过滤更省事；
# 本地调试想人读可以设 false
LOG_JSON=true
LOG_LEVEL=INFO
# 是否信任 X-Forwarded-For。
# ⚠️ 只有确实部署在可信反代（nginx）之后才设 true。
# 该请求头可被客户端伪造：盲信会让限流可绕过，还能借伪造 IP 把别人封掉，
# 并让伪造 IP 被当作评论者地址写进数据库
TRUST_PROXY_HEADERS=false
# 限流开关（登录 5/分、评论 5/分、点赞 20/分）。
# 压测或本地联调可临时关闭，生产不建议
RATE_LIMIT_ENABLED=true

# ---------- 初始化站长账号 ----------
# 仅在数据库里没有该用户时创建。「上线后请立即修改密码」
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# 是否写入演示文章（4 篇示例）。正式站设为 false
SEED_DEMO_DATA=true
