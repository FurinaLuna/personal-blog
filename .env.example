# ============================================================
# Docker 部署配置（docker compose 读的就是这一份）
#
#   cp .env.example .env        # 在**项目根目录**，不是 backend/.env
#   vim .env                    # 至少填下面三处「必填」
#   docker compose up -d --build
#
# 为什么是根目录：compose 的 ${VAR} 变量插值只读「项目根目录的 .env」和
# 当前 shell 环境，**不读**服务的 env_file。把配置写在 backend/.env 里，
# ${POSTGRES_PASSWORD} 一样取不到值，up 会直接报 required variable is missing。
# 为了让「插值」和「容器内配置」只有一个来源，backend 服务的 env_file
# 也指向本文件。
#
# 裸机开发（直接跑 uvicorn / vite）用的是 backend/.env，两者互不影响。
# 本文件没列到的配置项（上传白名单、限流、图片尺寸档位、访问日志留存…）
# 需要时照 backend/.env.example 里的同名变量加进来即可，容器会读到。
# ============================================================

# ---------- 必填：缺失会让 docker compose up 直接失败 ----------

# 数据库。密码不要用引号包起来，也不要用 # 和 $ 开头的口令
POSTGRES_USER=blog
POSTGRES_PASSWORD=
POSTGRES_DB=blog

# JWT 签名密钥：openssl rand -hex 32
# 留空、或沿用仓库里的开发默认值，等于任何人都能伪造登录态；
# 应用侧的 check_production_safety() 也会拒绝启动
JWT_SECRET_KEY=

# 站长账号的**初始**口令（只在首次启动建号时生效）。
# 用仓库默认值等于把管理员账号公开，同样会被启动门禁拦下
ADMIN_PASSWORD=

# ---------- 部署默认值：compose 已按生产设好，一般不用动 ----------
# 下面四项在 docker-compose.yml 里都有安全默认值，列在这里是让你知道
# 它们存在、需要时可以覆盖（.env 里的值优先）。
#
# APP_ENV=production      # development 会打开 /docs、放宽启动门禁
# DEBUG=false
# DB_AUTO_CREATE=false    # 表结构由容器入口的 alembic upgrade head 负责
# SEED_DEMO_DATA=false    # true 会往库里塞 4 篇演示文章

# ---------- 对外地址：上线必须改 ----------
# RSS / sitemap / 评论通知邮件里的链接全靠它拼绝对地址。
# 先用 http://localhost:8080 验证部署，上线改成正式域名（含协议、不带尾斜杠）
SITE_BASE_URL=http://localhost:8080
# 跨域白名单。同域部署（nginx 反代 /api）其实用不到它，
# 但接口调试、或把前端单独挂到别的域名时需要
CORS_ORIGINS=http://localhost:8080

# ---------- 评论邮件通知（可选）----------
# 关着的时候评论接口完全不受影响，只是不发信。
# 各邮箱服务商的填法见 backend/.env.example 里对应注释
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---------- 容器行为 ----------
# 启动时是否自动执行 alembic upgrade head。单副本保持 true 即可；
# 要起多副本时必须设为 false，改由发布流程单独跑一次迁移，
# 否则多个容器会同时写 alembic_version
RUN_MIGRATIONS_ON_STARTUP=true

# ---------- 端口与目录（一般不用动，需要时才覆盖）----------
# 这些在 docker-compose.yml 里都有默认值。**在这里显式列出来**不是多余：
# 它们决定了「数据落在宿主机的哪里」，而运维只会读这份文件 ——
# 没写等于不存在（backend/tests/test_deploy_config.py 会强制这条约定）。
#
# APP_PORT=8080
#   nginx 对外的宿主机端口。8080 被占用时改这里。
#   ⚠️ 改了要同步改上面的 SITE_BASE_URL 与 CORS_ORIGINS
#
# BACKUP_HOST_DIR=./backups
#   定时备份（compose 的 backup 服务）在宿主机的落盘目录。
#   想放到另一块盘：BACKUP_HOST_DIR=/mnt/backup/blog
# BACKUP_KEEP=14
#   只保留最近多少份备份（两种后缀一起轮转），与 make backup 的 --keep 同义
# BACKUP_INTERVAL_SECONDS=86400
#   自动备份间隔，默认一天一次。容器重启会立刻补一次
#
# CERTBOT_WEBROOT=./certbot-webroot
#   ACME HTTP-01 的挑战目录（自管证书时才用得上）
# TLS_CERTS_DIR=./deploy/certs
#   自管证书目录，容器内挂到 /etc/nginx/certs（只读）。
#   就是 certbot 的 /etc/letsencrypt，所以里面是 live/<域名>/ 这套布局
# TLS_PORT=443
#   自管证书时 HTTPS 的宿主机端口（docker-compose.tls.yml）。
# NGINX_CONF=nginx.conf
#   用哪套 nginx 主配置：nginx.conf（纯 HTTP）/ nginx.https.conf（自管证书）。
#   正常不要手改这个，TLS 部署请叠加 docker-compose.tls.yml（见 README「HTTPS」）
